#!/usr/bin/env raku

# bundle - Inline the shell config into a single bash rc file, for using these
# dotfiles on a machine without downloading or installing them:
#   bash --rcfile <(curl -fsSL URL)  # new shell
#   eval "$(curl -fsSL URL)"         # in a running bash
# (`source <(...)` silently reads nothing in macOS's bash 3.2 for a file this big.)
#
# Usage: scripts/bundle [START-FILE] >bundled.bashrc
#
# Only lines of the form `. "$DOTFILES/some/file"` or `source "$DOTFILES/some/file"`
# (optionally followed by `|| :`) are inlined. Everything else, including
# sources of files outside this repo, is left as-is.
#
# Some files that aren't sourced are embedded too: `__akn_bundled_file PATH`
# prints one, and the commands below run an embedded script.

my $repo = $*PROGRAM.resolve.parent.parent;

# Files embedded in the bundle, by repo-relative path
my @embedded-files = <dot-home/.inputrc bin/zap scripts/secure_path>;
# Shell functions that run an embedded script
my %embedded-commands = zap => 'bin/zap', __akn_bundled_secure_path => 'scripts/secure_path';

my $heredoc-end = 'AKN_BUNDLED_FILE_EOF';

sub embed-files() {
	say "__akn_bundled_file() \{";
	say "\tcase \$1 in";
	for @embedded-files -> $path {
		my $content = $repo.add($path).resolve.slurp;
		die "bundle: $path contains the line $heredoc-end" if $content.lines.grep($heredoc-end);
		say "\t\t$path) cat <<'$heredoc-end'";
		print $content;
		print "\n" unless $content.ends-with("\n");
		say $heredoc-end;
		say "\t\t\t;;";
	}
	say "\t\t*) echo \"__akn_bundled_file: not bundled: \$1\" >&2; return 1 ;;";
	say "\tesac";
	say "}";
	for %embedded-commands.sort -> (:key($name), :value($path)) {
		die "bundle: $path isn't in \@embedded-files" unless $path ∈ @embedded-files;
		my $file = $repo.add($path).resolve;
		# Linux limits a single argument (here, the `-c` script) to 128 KiB
		die "bundle: $path is too big to run with -c" if $file.s > 100_000;
		my $shebang = $file.lines.head;
		my $interpreter = do given $shebang {
			when /^ '#!' \s* '/usr/bin/env' \s+ (\S+) / { ~$0 }
			when /^ '#!' \s* (\S+) / { ~$0 }
			default { die "bundle: $path has no #! line" }
		};
		say "{$name}() \{ $interpreter -c \"\$(__akn_bundled_file $path)\" {$file.basename} \"\$@\"; \}";
	}
}

my @open-files; # for detecting cycles

sub relative(IO::Path $file) { $file.relative($repo) }

sub process-file(IO::Path $file) {
	if $file.Str ∈ @open-files».Str {
		die "bundle: cycle: {(|@open-files, $file).map(&relative).join(' -> ')}";
	}
	@open-files.push: $file;
	for $file.lines -> $line {
		if $line ~~ /^ \s* ['source'|'.'] \s+ '"$DOTFILES/' $<path>=(<-["$]>+) '"' [\s* '||' \s* ':']? \s* $/ {
			my $sourced-file = $repo.add(~$<path>).resolve;
			die "bundle: {relative $file}: no such file: $<path>" unless $sourced-file.f;
			say "## {relative $sourced-file}";
			process-file $sourced-file;
			say "## CONTINUED: {relative $file}";
			next;
		}
		if $line ~~ /^ \s* ['source'|'.'] \s .* 'DOTFILES'/ {
			note "bundle: warning: {relative $file}: not inlining: {$line.trim}";
		}
		say $line.subst(/^ '##'/, '###');
	}
	@open-files.pop;
}

sub MAIN(Str $start = $repo.add('config/bash/.bashrc').Str) {
	my $commit = (run 'git', '-C', $repo, 'rev-parse', '--short', 'HEAD', :out, :err).out.slurp(:close).trim;
	say "# Ajai's dotfiles: bash config bundled into one file by scripts/bundle{" from $commit" if $commit}.";
	say "# See https://github.com/AjaiKN/dotfiles";
	say "#   bash --rcfile <(curl -fsSL URL)  # new shell";
	say "#   eval \"\$(curl -fsSL URL)\"         # in a running bash";
	say "";
	say "# Truncation guard: bash reads this whole if-block before running any of it.";
	say "if : ; then";
	say "AKN_BUNDLED=1";
	embed-files;
	process-file $start.IO.resolve;
	say "fi";
}
