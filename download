#!/bin/sh

# curl https://dotfiles.ajai.dev | sh
# wget -O - https://dotfiles.ajai.dev/download | sh

# Truncation guard
if : ; then
	set -eu
	set -x

	umask 077

	confirm() {
		(
			set +x
			printf '%s (y/n) ' "$1"
			read -r REPLY </dev/tty
			case "$REPLY" in
				y*) : ;;
				Y*) : ;;
				*) return 2 ;;
			esac
		)
	}

	if ! [ -e "${DOTFILES:=$HOME/prog/dotfiles}" ]; then
		mkdir -p "$(dirname "$DOTFILES")"
		cd "$(dirname "$DOTFILES")"
		echo "Installing to $DOTFILES..."
		if command -v git >/dev/null 2>&1 && [ -z "${NO_GIT:-}" ]; then
			git clone --depth=1 "https://github.com/AjaiKN/dotfiles" "$DOTFILES"
			# shellcheck disable=SC2097,SC2098
			DOTFILES="$DOTFILES" "$DOTFILES"/submodules-update.sh
		else
			confirm "There's no git command in PATH. Use wget/curl instead?" || exit 2

			if command -v wget >/dev/null 2>&1; then
				wget 'https://github.com/AjaiKN/dotfiles/releases/latest/download/dotfiles.tar.gz'
			elif command -v curl >/dev/null 2>&1; then
				curl -LO 'https://github.com/AjaiKN/dotfiles/releases/latest/download/dotfiles.tar.gz'
			else
				echo "no curl or wget command available in PATH"
				exit 2
			fi

			mkdir -p "$DOTFILES"
			if command -v tar >/dev/null 2>&1; then
				tar -x -f dotfiles.tar.gz -k -C "$DOTFILES" --strip-components=1
			elif command -v bsdtar >/dev/null 2>&1; then
				bsdtar -x -f dotfiles.tar.gz -k -C "$DOTFILES" --strip-components=1
			else
				echo "no tar command available in PATH"
				exit 2
			fi
		fi
	fi

	if [ -e "$DOTFILES"/install ]; then
		set +x
		echo "Dotfiles are downloaded to $DOTFILES."
		echo "  i) install to home directory now"
		echo "  b) start bash using them, without installing"
		echo "  z) start zsh using them, without installing"
		echo "  n) neither"
		printf 'Choice? (i/b/z/n) '
		read -r REPLY </dev/tty
		case "$REPLY" in
			i* | I*)
				"$DOTFILES"/install -v </dev/tty || {
					ret=$?
					echo
					echo "Installing failed!"
					echo "To try again, run:"
					echo "$DOTFILES/install -v"
					exit $ret
				}
				;;
			b* | B*) exec "$DOTFILES"/scripts/bash </dev/tty ;;
			z* | Z*) exec "$DOTFILES"/scripts/zsh </dev/tty ;;
			*)
				echo "To install, run:"
				echo "$DOTFILES/install -v"
				echo "To start a shell using them without installing, run:"
				echo "$DOTFILES/scripts/bash  # or scripts/zsh"
				;;
		esac
	else
		echo "Failed to download"
		exit 1
	fi
fi
