#!/usr/bin/env bash

set -euo pipefail
# shellcheck disable=SC2154
trap 's=$?; echo >&2 "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

set -x

# If Emacs.app isn't already running, ...
if ! emacsclient -e t >/dev/null 2>&1; then
	exec emacs -nw --eval '(progn (full-calc) (akn/server-quit-mode))'
else
	export EMACS_SOCKET_NAME=term
	exec emacsclient -nw --eval '(progn (full-calc) (akn/server-quit-mode))'
fi
