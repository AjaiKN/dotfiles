#!/bin/sh

set -e

umask 077

tmphome="$(mktemp -d)" || exit 1
[ -d "$tmphome" ] || mkdir -p "$tmphome" >&2
chmod 0700 "$tmphome" >&2 || :
echo "$tmphome" >&2

export HOME="$tmphome"
export XDG_DATA_HOME="$tmphome/.local/share"
export XDG_CONFIG_HOME="$tmphome/.config"
export XDG_STATE_HOME="$tmphome/.local/state"
export XDG_CACHE_HOME="$tmphome/.cache"
export XDG_DATA_DIRS="$tmphome/usr/local/share/:$tmphome/usr/share/"
export XDG_CONFIG_DIRS="$tmphome/etc/xdg"

XDG_RUNTIME_DIR="$tmphome/runtime"
if mkdir -p "$XDG_RUNTIME_DIR" >&2 && chmod 0700 "$XDG_RUNTIME_DIR" >&2; then
	export XDG_RUNTIME_DIR
fi

export DOTFILES="$tmphome"

export TMPDIR="$tmphome/tmpdir"
mkdir -p "$TMPDIR"
export TMPPREFIX="$tmphome/tmpprefix"
mkdir -p "$TMPPREFIX"

for var in BASH_ENV ENV NIX_PROFILES ATUIN_HISTORY_ID ATUIN_SESSION AKN_SHELL_ENVVARS_LOADED; do
	unset "$var" >/dev/null 2>&1
	export "${var?}"  >/dev/null 2>&1
done

export USER=tmp
export LOGNAME=tmp

set +e
echo -------------------------------------------------------------------------------- >&2
"$@"
s=$?
echo -------------------------------------------------------------------------------- >&2

if command -v tree >/dev/null 2>&1; then
	tree -a --noreport "$tmphome" >&2
else
	ls -A "$tmphome" >&2
fi

rm -rf "$tmphome" >&2 && echo "Deleted $tmphome" >&2

exit $s
