#!/usr/bin/env bash

export PATH="$PATH:/Applications/Emacs.app/Contents/MacOS/bin"

# set -x

export EMACS_PLUS_NO_PATH_INJECTION=1

print_usage() {
	echo "Usage: $0 [-c|-f|--create-frame|--[new-]frame] [-T|--[new-]tab] [-t|--term[inal]] [-nw|--tty|--no-window-system] [-v|--verbose] [-w|--wait] [--] [file...]"
	echo "   or: $0 [-t|--term[inal]] [-nw|--tty|--no-window-system] [-v|--verbose] [-w|--wait] -n|--new [emacs_args...]"
}

# read options
verbose=
create_frame=
create_tab=
new_emacs=
term= # use term socket specifically
tty= # use tty without changing the socket
flags=() # to pass through to emacs or emacsclient
while [[ $# -gt 0 ]]; do
	case "$1" in
		(--version|-V)
			echo "emacs-open 0.0.1-pre"
			exit
			;;
		(--help|-h|-H)
			print_usage
			exit 0
			;;
		(-c|--create-frame|-f|--new-frame|--frame)
			create_frame=1
			shift
			;;
		(-t|--term|--terminal)
			term=1
			shift
			;;
		(-nw|--tty|--no-window-system)
			tty=1
			shift
			;;
		(-T|--new-tab|--tab)
			create_tab=1
			shift
			;;
		(-n|--new)
			new_emacs=1
			shift
			break # so that the rest of the flags (e.g., --profile) will go through to emacs
			;;
		(-w|--wait)
			wait=1
			shift
			;;
		(--verbose|-v)
			verbose=1
			shift
			;;
		(--)
			shift
			break
			;;
		(-[^-][^-]*) # expand multiple single-char options (e.g. -vf)
			opt="$1"
			shift
			other="${opt#-?}"
			set -- "${opt%"$other"}" "-${other}" "$@"
			;;
		(-)
			break
			;;
		(-*)
			echo "ERROR: Unknown option: $1"
			print_usage
			exit 1
			;;
		(*)
			break
			;;
	esac
done

if [[ -n "$term" ]]; then
	if [[ -z "${EMACS_SOCKET_NAME:-}" ]]; then
		export EMACS_SOCKET_NAME=term
	fi
	tty=1
	if [[ $# -eq 0 ]]; then
		set -- .
	fi
fi
if [[ -n "$tty" ]]; then
	create_frame=1
	wait=1
	flags+=(-nw)
fi
if [[ -n "$create_frame" ]]; then
	create_tab=
fi

# see if pipe is needed
needs_pipe=
if (( $# == 0 )) && [[ ! -t 0 ]] && [[ -t 2 ]]; then
	if [[ -n "$term" ]] && (( $# == 1 )) && [[ "$1" == "-" ]]; then
		exec epipe -nw
	fi
	# No args, stdin isn't a tty but stderr is -> something is probably being piped to us
	needs_pipe=1
fi
args=()
for arg in "$@"; do
	case "$arg" in
		-)
			if [[ -n "$create_frame" ]] || [[ -n "$new_emacs" ]]; then
				DIR=$(mktemp -d "$TMPDIR/epipe-$$.XXXXXXXXXX")
				out="$DIR/pipe"
				( umask 077; cat >"$out"; )
				args+=("$out")
			else
				needs_pipe=1
			fi
			;;
		*)
			args+=("$arg")
			;;
	esac
done
set -- "${args[@]}"

if [[ -n "$verbose" ]]; then
	set -x
fi

if [[ -n "$create_tab" ]]; then
	emacsclient -e '(tab-new)' >/dev/null
fi

if [ -n "$INSIDE_EMACS" ]; then
	emacsclient -n -- "$@"
else
	# Use this when you want a file to be open in Emacs
	# (Or you just want to open Emacs)

	# Open a file in graphical Emacs.
	# If Emacs is already running, open the file in the existing Emacs.
	# Don't wait for it to finish.

	if [[ -n "$EMACS_MAC" ]] && [[ -z "$tty" ]]; then
		if [[ $# -eq 0 ]] && [[ ${#flags[@]} -eq 0 ]]; then
			# number of args is zero
			open /Applications/Emacs.app
		elif [[ -z "$new_emacs" ]] && pgrep -f Emacs.app >/dev/null; then
			# emacs server/daemon is already running
			open /Applications/Emacs.app & # focus Emacs
			flags+=(-n)
			emacsclient "${flags[@]}" -- "$@"
		else
			open_flags=()
			if [[ -n "$wait" ]]; then
				open_flags+=(-W)
			fi
			if [[ -n "$new" ]]; then
				open_flags+=(-n)
			fi
			# emacs server/daemon is not running
			open "${open_flags[@]}" /Applications/Emacs.app --args "${flags[@]}" -- "$@"
		fi
	elif [[ -n "$new_emacs" ]]; then
		if [[ -n "$wait" ]]; then
			emacs "${flags[@]}" "$@"
		else
			nohup emacs "${flags[@]}" "$@" </dev/null >/dev/null 2>&1 &
		fi
	elif [[ -n "$wait" ]]; then
		if [[ -n "$create_frame" ]]; then
			flags+=(-c)
		fi
		exec emacsclient "${flags[@]}" "$@"
	else
		emacs-daemon-wait
		# open /Applications/Emacs.app & # focus Emacs
		if [[ "$(emacsclient -e '(display-graphic-p)')" != "nil" ]]; then
			# It's graphical emacs, and at least one frame is open.
			flags+=(-n)
			if [[ -n "$create_frame" ]]; then
				flags+=(-c)
			fi
			for arg in "$@"; do
				TERM=xterm-256color emacsclient "${flags[@]}" -- "$arg"
				flags=(-n) # reset flags (so we don't create extra new frames, for example)
			done
		else
			# Either it's tty emacs, or there are no frames open.
			if [[ "$(uname -s)" = "Linux" ]]; then
				# For some reason, emacsclient -c -n wasn't working on my Asahi Linux
				flags+=(-c)
				TERM=xterm-256color nohup emacsclient "${flags[@]}" -- "$@" </dev/null >/dev/null 2>&1 &
			else
				flags+=(-c -n)
				TERM=xterm-256color emacsclient "${flags[@]}" -- "$@"
			fi
			flags=(-n) # reset flags (so we don't create a new frame when focusing)
		fi
		emacsclient "${flags[@]}" -e '(ignore-errors (akn/focus-this-frame))' >/dev/null
	fi
fi

if [ -n "$needs_pipe" ]; then
	exec epipe
fi
