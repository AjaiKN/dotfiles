#!/usr/bin/env bash

FIRST="$1"
if [[ -z "$FIRST" ]]; then
	# $FIRST is empty
	# If you just run `git force` without an argument, this error/help message will appear
	echo "git-force: error: Need to provide a <refname> argument for --force-with-lease=" >&2
	echo -e "This is probably \e[34mthe name of the branch you're pushing to\e[0m." >&2
	echo -e "  $ git force \e[34mbranch-name\e[0m" >&2
	echo -e "Or you can specify \e[34m<refname>:<expect>\e[0m, where <refname> is the name of the branch you're pushing to and <expect> is what you think is the current state at the remote." >&2

	exit 1
fi
shift

CURRENT_BRANCH="$(git symbolic-ref --short HEAD)"
LEASE_REFNAME="${FIRST%%:*}"
if [[ "$LEASE_REFNAME" != "$CURRENT_BRANCH" ]]; then
	echo "git-force: error: lease refname '$LEASE_REFNAME' doesn't match the current branch '$CURRENT_BRANCH'." >&2
	echo -e "This command pushes your \e[34mcurrent branch\e[0m, so the lease refname must match it." >&2
	echo -e "  $ git checkout \e[34m$LEASE_REFNAME\e[0m" >&2
	echo "Or if you meant to push a different branch, check that one out first." >&2
	exit 1
fi

set -x
git push --force-if-includes --force-with-lease --force-with-lease="$FIRST" --no-recurse-submodules "$@"
