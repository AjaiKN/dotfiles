#!/usr/bin/env bash

set -euo pipefail
# shellcheck disable=SC2154
trap 's=$?; echo >&2 "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

if [[ $(git rev-parse --is-inside-work-tree 2>/dev/null) != true ]]; then
	echo "not in a git repository"
	exit 128
fi

# set -x

# If Emacs.app isn't already running, ...
if ! pgrep -f Emacs.app >/dev/null; then
	exec emacs -nw --eval '(progn (magit) (doom/window-maximize-buffer) (akn/server-quit-mode))'
else
	export EMACS_SOCKET_NAME=term
	exec emacsclient -nw --eval '(progn (magit) (doom/window-maximize-buffer) (akn/server-quit-mode))'
fi

