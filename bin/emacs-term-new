#!/usr/bin/env bash

# set -x

args=()
for arg in "$@"; do
	case "$arg" in
		-)
			DIR=$(mktemp -d "$TMPDIR/epipe-$$.XXXXXXXXXX")
			out="$DIR/pipe"
			( umask 077; cat >"$out"; )
			args+=("$out")
			;;
		*)
			args+=("$arg")
			;;
	esac
done
set -- "${args[@]}"

if [ -n "$INSIDE_EMACS" ]; then
	exec emacsclient "$@"
fi

# new Emacs in the terminal

exec emacs -nw "$@"
